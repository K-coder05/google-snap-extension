{
  "manifest_version": 3,
  "name": "Snapfit — Fullscreen Video in Your Browser Window",
  "version": "1.0.1",
  "description": "Make video fullscreen fill just the browser window instead of the whole display, so the rest of your screen stays visible.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "dist/service-worker.js", "type": "module" },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["dist/bridge.js"],
      "css": ["src/styles/pseudo.css"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
